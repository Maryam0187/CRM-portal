# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=booking_saas
DB_USER=root
DB_PASSWORD=password

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Application
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe (Test Mode)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret
# Get this from Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook
# Or from Stripe Dashboard when setting up webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (Optional - if not set, must create products in dashboard)
# Create these in Stripe Dashboard or via API
STRIPE_PRICE_GROWTH_MONTHLY=price_your_growth_monthly_id
STRIPE_PRICE_GROWTH_ANNUAL=price_your_growth_annual_id
STRIPE_PRICE_BUSINESS_MONTHLY=price_your_business_monthly_id
STRIPE_PRICE_BUSINESS_ANNUAL=price_your_business_annual_id
